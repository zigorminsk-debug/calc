<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="12dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvMemory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="M: 0"
        android:textColor="#888888"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="end"
        android:text=""
        android:textColor="#AAAAAA"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="end|bottom"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="52sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMemoryClear"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="MC" />

        <Button
            android:id="@+id/btnMemoryRead"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="MR" />

        <Button
            android:id="@+id/btnMemoryAdd"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="M+" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="DEL" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClear"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="C" />

        <Button
            android:id="@+id/btnSign"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="+/-" />

        <Button
            android:id="@+id/btnPercent"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="%" />

        <Button
            android:id="@+id/btnDiv"
            style="@style/Widget.Calc.Button.Operation"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="/" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn7"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="7" />

        <Button
            android:id="@+id/btn8"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="8" />

        <Button
            android:id="@+id/btn9"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="9" />

        <Button
            android:id="@+id/btnMul"
            style="@style/Widget.Calc.Button.Operation"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="x" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn4"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="4" />

        <Button
            android:id="@+id/btn5"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="5" />

        <Button
            android:id="@+id/btn6"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="6" />

        <Button
            android:id="@+id/btnSub"
            style="@style/Widget.Calc.Button.Operation"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="-" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn1"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="1" />

        <Button
            android:id="@+id/btn2"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="2" />

        <Button
            android:id="@+id/btn3"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="3" />

        <Button
            android:id="@+id/btnAdd"
            style="@style/Widget.Calc.Button.Operation"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn0"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="0" />

        <Button
            android:id="@+id/btnDot"
            style="@style/Widget.Calc.Button.Number"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="." />

        <Button
            android:id="@+id/btnPow"
            style="@style/Widget.Calc.Button.Operation"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="^" />

        <Button
            android:id="@+id/btnEquals"
            style="@style/Widget.Calc.Button.Operation"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="=" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSqrt"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="sqrt" />

        <Button
            android:id="@+id/btnLog"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="log" />

        <Button
            android:id="@+id/btnLn"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="ln" />

        <Button
            android:id="@+id/btnFactorial"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="n!" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSin"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="sin" />

        <Button
            android:id="@+id/btnCos"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="cos" />

        <Button
            android:id="@+id/btnTan"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="tan" />

        <Button
            android:id="@+id/btnSqr"
            style="@style/Widget.Calc.Button.Function"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="x^2" />
    </LinearLayout>

</LinearLayout>
